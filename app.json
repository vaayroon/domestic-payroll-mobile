{
  "expo": {
    "name": "Homeslip",
    "slug": "homeslip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homeslip",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "io.github.vaayroon.homeslip",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-mail-composer",
      [
        "expo-notifications",
        {
          "color": "#10b981",
          "defaultChannel": "payroll-reminder",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "@config-plugins/react-native-pdf",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f43eabf7-0f9b-40e6-b62b-4b473ecee30e"
      }
    },
    "owner": "vaayroons-team"
  }
}
